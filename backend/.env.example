PORT=5679

# Optional. SQLite 数据库文件位置（默认仓库根 data/huobao.sqlite3）
# SQLITE_PATH=/path/to/huobao.sqlite3

# Optional. 数据根目录（默认仓库根 data/；桌面版由 Electron 注入 HUOBAO_DATA_DIR）
# HUOBAO_DATA_DIR=/path/to/data
# STORAGE_PATH=/path/to/data/static

# Optional. MySQL → SQLite 启动自动迁移（老用户升级）：显式配置 DATABASE_URL 或
# MYSQL_HOST 且 SQLite 为空库时，启动自动一次性导入全部表（原子事务 + 行数校验 +
# 成功后写 .mysql-imported 标记）。关闭：MYSQL_AUTO_IMPORT=false
# DATABASE_URL=mysql://huobao:huobao@127.0.0.1:3306/huobao_drama

# Required if you use video/image providers that need PUBLIC URLs (e.g. AutoDL
# ComfyUI workflows, Seedance). Locally uploaded /static/ paths will be resolved
# as PUBLIC_BASE_URL + path so the upstream API can fetch them.
#
# Examples:
#   - Server has public IP: PUBLIC_BASE_URL=http://43.159.169.178:5679
#   - Behind a reverse proxy with HTTPS:
#       PUBLIC_BASE_URL=https://your-domain.com
#   - Behind a cloudflare tunnel:
#       PUBLIC_BASE_URL=https://xxx.trycloudflare.com
#   - Desktop version: leave UNSET (will throw a clear error when triggered)
PUBLIC_BASE_URL=http://your-public-ip:5679

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
